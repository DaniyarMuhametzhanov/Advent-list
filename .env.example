# Образец настроек для сервера. На сервере: cp .env.example .env и впиши свои значения.
# Сам .env в Git не попадает (он в .gitignore) — пароли живут только на сервере

# Твой домен, без https:// и без / в конце
DOMAIN=example.ru

# Пароль базы данных. Придумай длинный: openssl rand -hex 24
DB_PASSWORD=

# Пароль хранилища картинок MinIO (не короче 8 символов): openssl rand -hex 24
STORAGE_SECRET_KEY=
